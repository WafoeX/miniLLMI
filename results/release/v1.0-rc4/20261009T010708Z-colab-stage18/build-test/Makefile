	$(MAKE) $(MAKESILENT) -f CMakeFiles/convert_tiny_model.dir/build.make CMakeFiles/convert_tiny_model.dir/tools/convert_tiny_model.cpp.s
.PHONY : tools/convert_tiny_model.cpp.s

